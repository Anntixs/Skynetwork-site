@page "/docs/software"
@{ ViewData["Title"] = L["Software"]; }
<div class="wrap page with-side">
  <partial name="_DocsNav" />
  <div>
    <h1 style="font-size:34px">@L["Software"]</h1>
    <p class="muted">@L["Everything is free. Windows 10 or 11 is required."]</p>
    <div class="grid two" style="margin-top:24px">
      <div class="card">
        <div class="eyebrow">@L["For pilots"]</div>
        <h3>SkyPilot</h3>
        <p class="muted small">@L["The client for Microsoft Flight Simulator 2020 and 2024: network connection, flight plan from the website, messages, nearby controllers."]</p>
        <a class="btn btn-primary" href="https://github.com/Anntixs/skypilot/releases/latest">@L["Download SkyPilot"]</a>
      </div>
      <div class="card">
        <div class="eyebrow">@L["For controllers"]</div>
        <h3>Network-ATC</h3>
        <p class="muted small">@L["Radar: EuroScope and .natc sectors, handoffs, SID/STAR, departure and arrival lists, STCA, plugins."]</p>
        <a class="btn btn-primary" href="https://github.com/Anntixs/Network-ATC/releases/latest">@L["Download Network-ATC"]</a>
      </div>
    </div>
  </div>
</div>
