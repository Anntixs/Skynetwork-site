@page "/docs/software"
@{ ViewData["Title"] = "Программы"; }
<div class="wrap page with-side">
  <partial name="_DocsNav" />
  <div>
    <h1 style="font-size:34px">Программы</h1>
    <p class="muted">Всё бесплатно. Нужна Windows 10 или 11.</p>
    <div class="grid two" style="margin-top:24px">
      <div class="card">
        <div class="eyebrow">Пилотам</div>
        <h3>SkyPilot</h3>
        <p class="muted small">Клиент для Microsoft Flight Simulator 2020 и 2024: подключение к сети, план полёта с сайта, сообщения, список диспетчеров рядом.</p>
        <a class="btn btn-primary" href="https://github.com/Anntixs/skypilot/releases/latest">Скачать SkyPilot</a>
      </div>
      <div class="card">
        <div class="eyebrow">Диспетчерам</div>
        <h3>Network-ATC</h3>
        <p class="muted small">Радар: секторы EuroScope и .natc, передача бортов, SID/STAR, списки вылета и прилёта, STCA, плагины.</p>
        <a class="btn btn-primary" href="https://github.com/Anntixs/Network-ATC/releases/latest">Скачать Network-ATC</a>
      </div>
    </div>
  </div>
</div>
