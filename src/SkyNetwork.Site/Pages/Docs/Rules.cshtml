@page "/docs/rules"
@{ ViewData["Title"] = L["Network rules"]; }
<div class="wrap page with-side">
  <partial name="_DocsNav" />
  <div class="prose">
    <h1 style="font-size:34px">@L["Network rules"]</h1>
    <p class="muted">@L["A short set of rules. Supervisors make sure they are followed and can disconnect or suspend offenders."]</p>
    <h3 style="margin-top:28px">@L["General"]</h3>
    <p>@L["One account per person. Do not share your CID and password.\nRespect other members on the air and in messages.\nUse your real first and last name."]</p>
    <h3>@L["For pilots"]</h3>
    <p>@L["File a flight plan before connecting.\nDo not connect on runways or taxiways — only at a stand.\nFollow controller instructions; if you cannot, say so.\nIf you leave your computer for more than 30 minutes, disconnect."]</p>
    <h3>@L["For controllers"]</h3>
    <p>@L["Only staff positions your rating allows.\nKeep your controller information (ATIS) up to date and hand aircraft off to your neighbours.\nBook the position if you plan a long session."]</p>
    <h3>@L["Violations"]</h3>
    <p>@L["Report violations through"] <a href="/support">@L["support"]</a> @L["or to a supervisor on the network with the"] <span class="mono">.wallop</span> @L["command."]</p>
  </div>
</div>
