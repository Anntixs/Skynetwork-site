@page "/account/support/{id:long}"
@model SkyNetwork.Site.Pages.Account.TicketModel
@{ ViewData["Title"] = Model.Ticket.Subject; }
<div class="wrap page with-side">
  <partial name="_AccountNav" />
  <div>
    <div class="eyebrow">@L["Ticket"] #@Model.Ticket.Id · @L[SupportService.TicketStatuses[Model.Ticket.Status]]</div>
    <h1 style="font-size:28px">@Model.Ticket.Subject</h1>
    <div class="thread">
      @foreach (var msg in Model.Messages)
      {
        <div class="msg @(msg.Staff ? "staff" : "")">
          <div class="meta">@(msg.Staff ? L["SkyNetwork team"] : msg.Name) · @Format.Utc(msg.Created)</div>
          <p>@msg.Body</p>
        </div>
      }
    </div>
    @if (Model.Ticket.Status != "closed")
    {
      <form method="post" class="form">
        <label>@L["Reply"]<textarea name="Body" required maxlength="5000"></textarea></label>
        <div><button class="btn btn-primary" type="submit">@L["Send"]</button></div>
      </form>
    }
    else
    {
      <p class="muted">@L["The ticket is closed. If you still have a question,"] <a href="/account/support">@L["open a new one"]</a>.</p>
    }
  </div>
</div>
