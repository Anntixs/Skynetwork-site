@page "/register"
@model RegisterModel
@{ ViewData["Title"] = "Регистрация"; }
<div class="wrap page">
  <div class="auth-box">
    <h1 style="font-size:34px">Регистрация</h1>
    <p class="muted">После регистрации вы получите CID — номер участника для входа на сайт и в сеть.</p>
    @if (Model.Error != null) { <div class="alert error">@Model.Error</div> }
    <form method="post" class="form">
      <label>Имя и фамилия
        <input name="Name" value="@Model.Name" required maxlength="60" autocomplete="name">
        <span class="hint">Так вас увидят другие участники.</span>
      </label>
      <label>Электронная почта
        <input name="Email" type="email" value="@Model.Email" required maxlength="120" autocomplete="email">
      </label>
      <label>Страна
        <select name="Country" required autocomplete="country-name">
          <option value="">Выберите страну</option>
          @foreach (var country in SkyNetwork.Site.Data.Countries.All)
          {
            <option value="@country" selected="@(Model.Country == country)">@country</option>
          }
        </select>
      </label>
      <label>Пароль
        <input name="Password" type="password" required minlength="8" autocomplete="new-password">
        <span class="hint">Не короче 8 символов.</span>
      </label>
      <label>Пароль ещё раз
        <input name="Confirm" type="password" required minlength="8" autocomplete="new-password">
      </label>
      <label class="check"><input type="checkbox" name="AcceptRules" value="true" required> <span>Я прочитал <a href="/docs/rules" target="_blank">правила сети</a> и согласен их соблюдать.</span></label>
      <button class="btn btn-primary" type="submit">Зарегистрироваться</button>
      <p class="muted small">Уже есть CID? <a href="/login">Войти</a></p>
    </form>
  </div>
</div>
