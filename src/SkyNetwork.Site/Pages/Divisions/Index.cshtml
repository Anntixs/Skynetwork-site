@page "/divisions"
@inject DivisionService Divisions
@{ ViewData["Title"] = L["Divisions"]; var list = Divisions.All(activeOnly: true); }
<div class="wrap page">
  <h1 style="font-size:34px">@L["Divisions"]</h1>
  <p class="muted" style="max-width:720px">@L["Divisions are the regional branches of the network. Each runs its own academy: it trains controllers and pilots, holds the exams and asks the network for the ratings its students earned."]</p>
  @if (list.Count == 0) { <div class="empty">@L["No divisions yet."]</div> }
  <div class="grid two" style="gap:16px;margin-top:20px">
    @foreach (var d in list)
    {
      <a class="card" href="/divisions/@d.Code" style="color:inherit;text-decoration:none">
        <div class="section-head" style="margin-bottom:6px">
          <h3 style="margin:0">@d.Name</h3>
          <span class="badge accent">@d.Code</span>
        </div>
        <div class="muted small">@(d.Region.Length > 0 ? d.Region + " · " : "")@d.MemberCount @L.Plural((int)d.MemberCount, "member", "members")</div>
        @if (d.Description.Length > 0) { <p style="margin:10px 0 0">@d.Description</p> }
      </a>
    }
  </div>
</div>
