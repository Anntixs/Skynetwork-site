@page "/events/{id:long}"
@model SkyNetwork.Site.Pages.Events.DetailsModel
@{
    var e = Model.Event;
    bool en = !L.IsRu;
    ViewData["Title"] = e.TitleIn(en);
}
<div class="wrap page">
  @if (e.BannerUrlIn(en) is { } banner) { <img class="page-banner @e.BannerClasses" src="@banner" alt=""> }
  <div class="eyebrow"><a href="/events">@L["Events"]</a></div>
  <h1>@e.TitleIn(en)</h1>
  <p class="muted"><span class="date-chip">@Format.Span(e.Start, e.End)</span> @if (e.Airports.Length > 0) { <span class="mono">@e.Airports</span> }</p>
  @if (!e.Published) { <div class="alert">@L["Draft — visible to the team only."]</div> }
  @if (e.SummaryIn(en) is { Length: > 0 } summary) { <p style="font-size:18px">@summary</p> }
  <div class="prose"><p>@e.BodyIn(en)</p></div>
  <p style="margin-top:28px"><a class="btn" href="/bookings">@L["Book a position"]</a> <a class="btn" href="/flightplan">@L["File a flight plan"]</a></p>
</div>
