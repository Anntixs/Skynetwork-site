@page "/events"
@inject ContentService Site
@{
    ViewData["Title"] = L["Events"];
    var events = Site.UpcomingEvents(60);
    bool en = !L.IsRu;
}
<div class="wrap page">
  <div class="page-head">
    <h1>@L["Events"]</h1>
    <p>@L["Busy traffic days, fly-ins and open positions. Controllers are fully staffed during events — the best time for a first flight."]</p>
  </div>
  @if (events.Count == 0)
  {
    <div class="empty">@L["No upcoming events. Keep an eye on the"] <a href="/news">@L["news"]</a>.</div>
  }
  else
  {
    <div class="grid three">
      @foreach (var e in events)
      {
        <a class="card @(e.BannerUrlIn(en) != null ? "with-banner" : "")" href="/events/@e.Id">
          @if (e.BannerUrlIn(en) is { } banner)
          {
            <span class="card-banner @e.BannerClasses">@if (e.BannerWhole) { <img class="banner-fill" src="@banner" alt="" loading="lazy"> }<img src="@banner" alt="" loading="lazy"></span>
          }
          <span class="date-chip">@Format.Span(e.Start, e.End)</span>
          <h3>@e.TitleIn(en)</h3>
          <p class="muted small">@e.SummaryIn(en)</p>
          @if (e.Airports.Length > 0) { <span class="mono small">@e.Airports</span> }
        </a>
      }
    </div>
  }
</div>
