@page "/staff/members"
@model SkyNetwork.Site.Pages.Staff.MembersModel
@{ ViewData["Title"] = "Участники"; }
<h1 style="font-size:30px">Участники</h1>
<form method="get" class="inline-form" style="margin-bottom:20px">
  <label>Поиск<input name="q" value="@Model.Query" placeholder="CID, имя или почта" style="width:320px"></label>
  <button class="btn" type="submit">Найти</button>
</form>
<div class="table-wrap">
  <table>
    <thead><tr><th>CID</th><th>Имя</th><th>Почта</th><th>Рейтинг</th><th>Регистрация</th><th>Статус</th></tr></thead>
    <tbody>
    @foreach (var m in Model.Results)
    {
      <tr>
        <td class="mono"><a href="/staff/members/@m.Cid">@m.Cid</a></td>
        <td>@m.Name</td>
        <td class="small">@m.Email</td>
        <td>@m.RatingShort</td>
        <td>@(m.Registered is { } r ? Format.Date(r) : "—")</td>
        <td>@if (m.Suspended) { <span class="badge danger">заблокирован</span> } else { <span class="badge ok">активен</span> }</td>
      </tr>
    }
    @if (Model.Results.Count == 0) { <tr><td colspan="6" class="muted">Никого не нашли</td></tr> }
    </tbody>
  </table>
</div>
