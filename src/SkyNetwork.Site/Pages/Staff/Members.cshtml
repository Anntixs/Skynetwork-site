@page "/staff/members"
@model SkyNetwork.Site.Pages.Staff.MembersModel
@{ ViewData["Title"] = L["Members"]; }
<h1 style="font-size:30px">@L["Members"]</h1>
@if (Model.Message != null) { <div class="alert ok">@Model.Message</div> }
@if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }
<form method="get" class="inline-form" style="margin-bottom:20px">
  <label>@L["Search"]<input name="q" value="@Model.Query" placeholder="@L["CID, name or email"]" style="width:320px"></label>
  <label class="check" style="align-self:center"><input type="checkbox" name="suspended" value="1" checked="@Model.SuspendedOnly"> <span>@L["Suspended only"]</span></label>
  <label class="check" style="align-self:center"><input type="checkbox" name="suspicious" value="1" checked="@Model.SuspiciousOnly"> <span>@L["Suspicious only"]</span></label>
  <button class="btn" type="submit">@L["Search"]</button>
</form>
@if (Model.CanSuspend)
{
  @* Tick members in the list and suspend them together (the ticks belong to this form through form="bulk"). *@
  <form method="post" asp-page="/Staff/Members" asp-page-handler="Suspend" id="bulk" class="inline-form bulk-bar" onsubmit="return confirm('@L["Suspend the ticked members?"]')">
    <input type="hidden" name="q" value="@Model.Query">
    @if (Model.SuspendedOnly) { <input type="hidden" name="suspended" value="1"> }
    @if (Model.SuspiciousOnly) { <input type="hidden" name="suspicious" value="1"> }
    <label>@L["Reason"]<input name="reason" value="@L["Junk registration"]" maxlength="200" style="width:320px"></label>
    <button class="btn btn-danger" type="submit">@L["Suspend ticked"]</button>
  </form>
}
<div class="table-wrap">
  <table>
    <thead><tr>@if (Model.CanSuspend) { <th style="width:36px"><input type="checkbox" aria-label="@L["Tick all"]" onclick="for (const b of document.querySelectorAll('input[name=cids]')) b.checked = this.checked"></th> }<th>CID</th><th>@L["Name"]</th><th>@L["Email"]</th><th>@L["Ratings"]</th><th>@L["Registered"]</th><th>@L["Status"]</th></tr></thead>
    <tbody>
    @foreach (var m in Model.Results)
    {
      <tr>
        @if (Model.CanSuspend) { <td><input type="checkbox" name="cids" value="@m.Cid" form="bulk" aria-label="@m.Cid"></td> }
        <td class="mono"><a href="/staff/members/@m.Cid">@m.Cid</a></td>
        <td>@m.Name</td>
        <td class="small">@m.Email</td>
        <td class="mono small">@m.DisplayShort · @PilotRatings.Pilot.Short(m.PilotRating) · @PilotRatings.Military.Short(m.MilitaryRating)</td>
        <td>@(m.Registered is { } r ? Format.Date(r) : "—")</td>
        <td>@if (m.Suspended)
            {
              <span class="badge danger">@L["suspended"]</span>
              @if (m.SuspensionEnds is { } until) { <span class="muted small"> @L["until"] @Format.Utc(until)</span> }
            }
            else { <span class="badge ok">@L["active"]</span> }
            @if (SignupGuard.Suspicion(m) is { } why) { <span class="badge warn" title="@L[why]">@L["suspicious"]</span> }</td>
      </tr>
    }
    @if (Model.Results.Count == 0) { <tr><td colspan="7" class="muted">@L["No one found"]</td></tr> }
    </tbody>
  </table>
</div>
