@page "/staff/news"
@model SkyNetwork.Site.Pages.Staff.NewsModel
@{ ViewData["Title"] = "Новости"; }
<div class="section-head"><h1 style="font-size:30px;margin:0">Новости</h1><a class="btn btn-primary" href="/staff/news/new">Написать новость</a></div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Заголовок</th><th>Автор</th><th>Дата</th><th>Статус</th></tr></thead>
    <tbody>
    @foreach (var n in Model.List)
    {
      <tr>
        <td><a href="/staff/news/@n.Id">@n.Title</a></td>
        <td>@n.AuthorName</td>
        <td>@Format.Date(n.Created)</td>
        <td>@if (n.Published) { <span class="badge ok">опубликовано</span> } else { <span class="badge">черновик</span> }</td>
      </tr>
    }
    @if (Model.List.Count == 0) { <tr><td colspan="4" class="muted">Новостей нет</td></tr> }
    </tbody>
  </table>
</div>
