@page "/staff/team"
@model SkyNetwork.Site.Pages.Staff.TeamModel
@{ ViewData["Title"] = L["Team"]; }
<h1 style="font-size:30px">@L["Team"]</h1>
<p class="muted">@L["Administrators, supervisors, instructors and members with website roles."]</p>
<div class="table-wrap">
  <table>
    <thead><tr><th>CID</th><th>@L["Name"]</th><th>@L["Rating"]</th><th>@L["Roles"]</th></tr></thead>
    <tbody>
    @foreach (var (m, roles) in Model.Team)
    {
      <tr>
        <td class="mono">@if (Model.Me.Has(Perm.ViewMembers)) { <a href="/staff/members/@m.Cid">@m.Cid</a> } else { @m.Cid }</td>
        <td>@m.Name</td>
        <td><span class="badge accent">@m.RatingShort</span> @L[m.RatingLong]</td>
        <td>@string.Join(", ", roles.Select(r => L[Permissions.Roles[r]]))</td>
      </tr>
    }
    </tbody>
  </table>
</div>
