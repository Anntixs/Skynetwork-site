@page "/staff/training"
@model SkyNetwork.Site.Pages.Staff.TrainingModel
@{ ViewData["Title"] = L["Training"]; }
<h1 style="font-size:30px">@L["Training requests"]</h1>
@if (Model.Message != null) { <div class="alert ok">@L[Model.Message]</div> }
@if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }
<div class="inline-form" style="margin-bottom:16px">
  <a class="btn btn-small @(Model.All ? "" : "btn-primary")" href="/staff/training">@L["Active"]</a>
  <a class="btn btn-small @(Model.All ? "btn-primary" : "")" href="/staff/training?all=1">@L["All"]</a>
</div>
@if (Model.List.Count == 0) { <div class="empty">@L["No requests."]</div> }
<div class="grid" style="gap:12px">
  @foreach (var r in Model.List)
  {
    <div class="card">
      <div class="section-head" style="margin-bottom:6px">
        <h3 style="margin:0"><a href="/staff/members/@r.Cid">@r.Name</a> <span class="muted small mono">@r.Cid</span></h3>
        <span class="badge @(r.Status == "open" ? "warn" : r.Status == "accepted" ? "accent" : "")">@L[SupportService.TrainingStatuses[r.Status]]</span>
      </div>
      <div class="muted small">@if (r.DivisionCode.Length > 0) { <b>@r.DivisionCode · </b> }@L[TrainingTracks.All.First(t => t.Key == r.Track).Title] · @r.CurrentShort → <b>@r.TargetShort</b> · @L["filed"] @Format.Utc(r.Created)</div>
      @if (r.Message.Length > 0) { <p style="white-space:pre-line;margin:10px 0">@r.Message</p> }
      <form method="post" class="inline-form" style="margin-top:10px">
        <input type="hidden" name="id" value="@r.Id">
        <label>@L["Status"]
          <select name="status">
            @foreach (var (key, title) in SupportService.TrainingStatuses) { <option value="@key" selected="@(key == r.Status)">@L[title]</option> }
          </select>
        </label>
        <label style="flex:1">@L["Comment for the member"]<input name="comment" value="@r.StaffComment" maxlength="1000"></label>
        <label class="check" style="align-self:center"><input type="checkbox" name="promote" value="true"> <span>@L.F("grant {0}", r.TargetShort)</span></label>
        <button class="btn btn-primary" type="submit">@L["Save"]</button>
      </form>
    </div>
  }
</div>
