@page "/staff/events"
@model SkyNetwork.Site.Pages.Staff.EventsModel
@{ ViewData["Title"] = L["Events"]; }
<div class="section-head"><h1 style="font-size:30px;margin:0">@L["Events"]</h1><a class="btn btn-primary" href="/staff/events/new">@L["New event"]</a></div>
<div class="table-wrap">
  <table>
    <thead><tr><th>@L["Title"]</th><th>@L["When"]</th><th>@L["Airports"]</th><th>@L["Status"]</th></tr></thead>
    <tbody>
    @foreach (var e in Model.List)
    {
      <tr>
        <td><a href="/staff/events/@e.Id">@e.TitleIn(!L.IsRu)</a>@if (e.Title.Length > 0 && e.TitleEn.Length > 0) { <span class="badge" style="margin-left:8px">RU · EN</span> }</td>
        <td>@Format.Span(e.Start, e.End)</td>
        <td class="mono">@e.Airports</td>
        <td>@if (!e.Published) { <span class="badge">@L["draft"]</span> } else if (e.End < DateTime.UtcNow) { <span class="badge">@L["past"]</span> } else { <span class="badge ok">@L["published"]</span> }</td>
      </tr>
    }
    @if (Model.List.Count == 0) { <tr><td colspan="4" class="muted">@L["No events"]</td></tr> }
    </tbody>
  </table>
</div>
