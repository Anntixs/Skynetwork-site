@page "/staff/events"
@model SkyNetwork.Site.Pages.Staff.EventsModel
@{ ViewData["Title"] = "Мероприятия"; }
<div class="section-head"><h1 style="font-size:30px;margin:0">Мероприятия</h1><a class="btn btn-primary" href="/staff/events/new">Новое мероприятие</a></div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Название</th><th>Когда</th><th>Аэродромы</th><th>Статус</th></tr></thead>
    <tbody>
    @foreach (var e in Model.List)
    {
      <tr>
        <td><a href="/staff/events/@e.Id">@e.Title</a></td>
        <td>@Format.Span(e.Start, e.End)</td>
        <td class="mono">@e.Airports</td>
        <td>@if (!e.Published) { <span class="badge">черновик</span> } else if (e.End < DateTime.UtcNow) { <span class="badge">прошло</span> } else { <span class="badge ok">опубликовано</span> }</td>
      </tr>
    }
    @if (Model.List.Count == 0) { <tr><td colspan="4" class="muted">Мероприятий нет</td></tr> }
    </tbody>
  </table>
</div>
