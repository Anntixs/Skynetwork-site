@page "/staff/events/{id}"
@model SkyNetwork.Site.Pages.Staff.EventEditModel
@{ var e = Model.Event; ViewData["Title"] = e.Id == 0 ? L["New event"] : e.Title; }
<div class="eyebrow"><a href="/staff/events">@L["Events"]</a></div>
<h1 style="font-size:28px">@(e.Id == 0 ? L["New event"] : e.Title)</h1>
@if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }
<form method="post" class="form wide">
  <label>@L["Title"]<input name="Title" value="@e.Title" required maxlength="120"></label>
  <label>@L["Summary"]<input name="Summary" value="@e.Summary" maxlength="240"><span class="hint">@L["One line for the card on the home page."]</span></label>
  <label>@L["Airports"]<input name="Airports" value="@e.Airports" class="mono" maxlength="120" placeholder="UUEE UUDD"></label>
  <div class="row">
    <label>@L["Start date, UTC"]<input name="StartDate" type="date" value="@Format.InputDate(e.Start)" required></label>
    <label>@L["Time"]<input name="StartTime" type="time" value="@Format.InputTime(e.Start)" required></label>
    <label>@L["End date"]<input name="EndDate" type="date" value="@Format.InputDate(e.End)" required></label>
    <label>@L["Time"]<input name="EndTime" type="time" value="@Format.InputTime(e.End)" required></label>
  </div>
  <label>@L["Description"]<textarea name="Body" maxlength="10000" style="min-height:220px">@e.Body</textarea></label>
  <label class="check"><input type="checkbox" name="Published" value="true" checked="@e.Published"> <span>@L["Publish"]</span></label>
  <div class="inline-form">
    <button class="btn btn-primary" type="submit">@L["Save"]</button>
    @if (e.Id != 0) { <a class="btn" href="/events/@e.Id">@L["Open on the website"]</a> }
  </div>
</form>
@if (e.Id != 0)
{
  <form method="post" asp-page-handler="Delete" style="margin-top:28px" onsubmit="return confirm('@L["Delete the event?"]')">
    <button class="btn btn-danger" type="submit">@L["Delete event"]</button>
  </form>
}
