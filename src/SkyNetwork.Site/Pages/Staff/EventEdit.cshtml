@page "/staff/events/{id}"
@model SkyNetwork.Site.Pages.Staff.EventEditModel
@{ var e = Model.Event; ViewData["Title"] = e.Id == 0 ? "Новое мероприятие" : e.Title; }
<div class="eyebrow"><a href="/staff/events">Мероприятия</a></div>
<h1 style="font-size:28px">@(e.Id == 0 ? "Новое мероприятие" : e.Title)</h1>
@if (Model.Error != null) { <div class="alert error">@Model.Error</div> }
<form method="post" class="form wide">
  <label>Название<input name="Title" value="@e.Title" required maxlength="120"></label>
  <label>Кратко<input name="Summary" value="@e.Summary" maxlength="240"><span class="hint">Одна строка для карточки на главной.</span></label>
  <label>Аэродромы<input name="Airports" value="@e.Airports" class="mono" maxlength="120" placeholder="UUEE UUDD"></label>
  <div class="row">
    <label>Дата начала, UTC<input name="StartDate" type="date" value="@Format.InputDate(e.Start)" required></label>
    <label>Время<input name="StartTime" type="time" value="@Format.InputTime(e.Start)" required></label>
    <label>Дата окончания<input name="EndDate" type="date" value="@Format.InputDate(e.End)" required></label>
    <label>Время<input name="EndTime" type="time" value="@Format.InputTime(e.End)" required></label>
  </div>
  <label>Описание<textarea name="Body" maxlength="10000" style="min-height:220px">@e.Body</textarea></label>
  <label class="check"><input type="checkbox" name="Published" value="true" checked="@e.Published"> <span>Опубликовать</span></label>
  <div class="inline-form">
    <button class="btn btn-primary" type="submit">Сохранить</button>
    @if (e.Id != 0) { <a class="btn" href="/events/@e.Id">Открыть на сайте</a> }
  </div>
</form>
@if (e.Id != 0)
{
  <form method="post" asp-page-handler="Delete" style="margin-top:28px" onsubmit="return confirm('Удалить мероприятие?')">
    <button class="btn btn-danger" type="submit">Удалить мероприятие</button>
  </form>
}
