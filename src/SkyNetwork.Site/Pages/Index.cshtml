@page
@model IndexModel
@{
    var s = Model.Online;
}
@section Head {
  <link rel="stylesheet" href="~/lib/leaflet/leaflet.css">
}
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">@L["Virtual aviation network"]</div>
      <h1>@L["One sky for pilots and controllers"]</h1>
      <p class="lead">@L["On SkyNetwork pilots fly in MSFS while controllers guide them from the ground — for real, on the radio and by the rules. Membership is free."]</p>
      <div class="hero-actions">
        @if (Me.IsSignedIn)
        {
          <a class="btn btn-primary" href="/flightplan">@L["File a flight plan"]</a>
          <a class="btn" href="/map">@L["Live map"]</a>
        }
        else
        {
          <a class="btn btn-primary" href="/register">@L["Register"]</a>
          <a class="btn" href="/docs">@L["Getting started"]</a>
        }
      </div>
      <div class="live-line">
        @if (s.Available)
        {
          <span class="dot"></span>
          <span>@L["On the air now:"] <b>@s.Pilots.Count</b> @L.Plural(s.Pilots.Count, "pilot", "pilots") @L["and"] <b>@s.Controllers.Count</b> @L.Plural(s.Controllers.Count, "controller", "controllers")</span>
        }
        else
        {
          <span class="dot off"></span><span>@L["The server is not responding right now"]</span>
        }
      </div>
    </div>
    <div class="hero-map" id="map" data-compact="1" aria-label="@L["Traffic map"]"></div>
  </div>
</section>

<section class="section band">
  <div class="wrap">
    <div class="section-head">
      <h2>@L["Controllers on the air"]</h2>
      <a href="/online">@L["Everyone online →"]</a>
    </div>
    @if (s.Controllers.Count == 0)
    {
      <div class="empty">@L["No one is on position right now."] <a href="/bookings">@L["Book a position"]</a> @L["so pilots know when you will be on."]</div>
    }
    else
    {
      <div class="strips two">
        @foreach (var c in s.Controllers.Take(8))
        {
          <div class="strip @c.FacilityName">
            <span class="cs">@c.Callsign</span>
            <span class="who">@c.Name · @c.Rating</span>
            <span class="freq">@c.Frequency</span>
          </div>
        }
      </div>
    }
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>@L["Upcoming events"]</h2>
      <a href="/events">@L["All events →"]</a>
    </div>
    @if (Model.Events.Count == 0)
    {
      <div class="empty">@L["No events planned yet."]</div>
    }
    else
    {
      <div class="grid three">
        @foreach (var e in Model.Events)
        {
          <a class="card" href="/events/@e.Id">
            <span class="date-chip">@Format.Span(e.Start, e.End)</span>
            <h3>@e.Title</h3>
            <p class="muted small">@e.Summary</p>
            @if (e.Airports.Length > 0) { <span class="mono small">@e.Airports</span> }
          </a>
        }
      </div>
    }
  </div>
</section>

<section class="section">
  <div class="wrap grid two" style="gap:48px">
    <div>
      <div class="section-head"><h2>@L["Getting started"]</h2></div>
      <div class="steps" style="grid-template-columns:1fr">
        <div class="step"><h3>@L["Register"]</h3><p class="muted small">@L["You get a CID, your member number. With it and your password you sign in to the website and the network."]</p></div>
        <div class="step"><h3>@L["Install the software"]</h3><p class="muted small">@L["Pilots use SkyPilot for MSFS 2020/2024, controllers use the Network-ATC radar."] <a href="/docs/software">@L["Download"]</a></p></div>
        <div class="step"><h3>@L["Get on the air"]</h3><p class="muted small">@L["File a flight plan on the website and connect. Controllers need a rating — start with"] <a href="/docs/ratings">@L["training"]</a>.</p></div>
      </div>
    </div>
    <div>
      <div class="section-head"><h2>@L["News"]</h2><a href="/news">@L["All news →"]</a></div>
      @if (Model.News.Count == 0)
      {
        <div class="empty">@L["No news yet."]</div>
      }
      <div class="news-list">
        @foreach (var n in Model.News)
        {
          <div class="news-item">
            <div class="muted small">@Format.Date(n.Created)</div>
            <h3><a href="/news/@n.Id">@n.Title</a></h3>
            <p class="muted small">@(n.Body.Length > 180 ? n.Body[..180] + "…" : n.Body)</p>
          </div>
        }
      </div>
    </div>
  </div>
</section>

@section Scripts {
  <script src="~/lib/leaflet/leaflet.js"></script>
  <script src="~/js/map.js" asp-append-version="true"></script>
}
