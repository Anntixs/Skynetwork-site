@page "/login"
@model LoginModel
@{ ViewData["Title"] = L["Sign in"]; }
<div class="wrap page">
  <div class="auth-box">
    <h1 style="font-size:34px">@L["Sign in"]</h1>
    @if (Model.ConnectSite is { } site) { <div class="alert">@L.F("Sign in with your SkyNetwork account to continue to {0}.", site)</div> }
    <p class="muted">@L["Your CID and password are the same as for connecting to the network."]</p>
    @if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }
    <form method="post" class="form">
      <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
      <label>CID
        <input name="Cid" value="@(Model.Cid == 0 ? "" : Model.Cid)" inputmode="numeric" required autocomplete="username" class="mono">
      </label>
      <label>@L["Password"]
        <input name="Password" type="password" required autocomplete="current-password">
      </label>
      <label class="check"><input type="checkbox" name="Remember" value="true" checked> <span>@L["Remember me"]</span></label>
      <button class="btn btn-primary" type="submit">@L["Sign in"]</button>
      <p class="muted small">@L["No CID yet?"] <a href="/register">@L["Register"]</a>. <a href="/forgot-password">@L["Forgot your password?"]</a></p>
    </form>
  </div>
</div>
