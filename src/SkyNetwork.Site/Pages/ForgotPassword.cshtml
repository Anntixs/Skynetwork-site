@page "/forgot-password"
@model ForgotPasswordModel
@{ ViewData["Title"] = L["Forgot your password?"]; }
<div class="wrap page">
  <div class="auth-box">
    <h1 style="font-size:34px">@L["Forgot your password?"]</h1>
    @if (!Model.Enabled)
    {
      <p>@L["Write to support: we will check that the account is yours and set a new password."] <a href="/support">@L["Write to support"]</a></p>
    }
    else if (Model.Sent)
    {
      <div class="alert ok">@L["If there is an account with this CID or email, we have sent a link to its email address. The link works for one hour."]</div>
      <p class="muted small">@L["No letter? Check the spam folder, or write to support."] <a href="/support">@L["Write to support"]</a></p>
    }
    else
    {
      <p class="muted">@L["Enter your CID or email: we will send a link to set a new password to the account's email address."]</p>
      <form method="post" class="form">
        <label>@L["CID or email"]<input name="Login" required autocomplete="username"></label>
        <button class="btn btn-primary" type="submit">@L["Send the link"]</button>
      </form>
    }
  </div>
</div>
