@page "/developers"
@{ ViewData["Title"] = "API"; var host = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}"; }
<div class="wrap page with-side">
  <partial name="_DocsNav" />
  <div>
    <h1 style="font-size:34px">@L["Developer API"]</h1>
    <p class="muted" style="max-width:640px">@L["An open read-only API: JSON, no keys, CORS allowed. Online data refreshes every 15 seconds — do not request it more often."]</p>
    <div class="table-wrap" style="margin-top:20px">
      <table>
        <thead><tr><th>@L["Request"]</th><th>@L["Returns"]</th></tr></thead>
        <tbody>
          <tr><td class="mono">GET /api/v1/status</td><td>@L["Network name, FSD server address, data status"]</td></tr>
          <tr><td class="mono">GET /api/v1/online</td><td>@L["Pilots (position, altitude, speed, heading, flight plan) and controllers (frequency, rating, position)"]</td></tr>
          <tr><td class="mono">GET /api/v1/stats</td><td>@L["Members, online, number of connections"]</td></tr>
          <tr><td class="mono">GET /api/v1/members/{cid}</td><td>@L["Member profile: name, controller, pilot and military ratings, pilot and controller hours"]</td></tr>
          <tr><td class="mono">GET /api/v1/members/{cid}/sessions</td><td>@L["Last 50 connections"]</td></tr>
          <tr><td class="mono">GET /api/v1/events</td><td>@L["Upcoming events"]</td></tr>
          <tr><td class="mono">GET /api/v1/events/{id}</td><td>@L["An event"]</td></tr>
          <tr><td class="mono">GET /api/v1/bookings</td><td>@L["Position bookings"]</td></tr>
          <tr><td class="mono">GET /api/v1/news</td><td>@L["News"]</td></tr>
          <tr><td class="mono">GET /api/v1/pilots/{callsign}/route</td><td>@L["An online pilot's route as points (from SimBrief or worked out from the flight plan), the flown track and, for SimBrief plans, registration and step climbs"]</td></tr>
          <tr><td class="mono">GET /api/v1/routes/decode?departure=UUEE&amp;destination=EDDF&amp;route=…</td><td>@L["A route text as points: waypoints, airways expanded, coordinates; the tokens not found"]</td></tr>
          <tr><td class="mono">GET /api/v1/airports/{icao}/layout</td><td>@L["Airport diagram: runways, taxiways, aprons, stands (OpenStreetMap)"]</td></tr>
          <tr><td class="mono">GET /api/v1/metar/{icao}</td><td>@L["Current METAR"]</td></tr>
          <tr><td class="mono">GET /api/flightplans/latest?cid={cid}</td><td>@L["The member's latest flight plan (SkyPilot format); 404 if there is none"]</td></tr>
        </tbody>
      </table>
    </div>
    <h2 style="font-size:20px;margin-top:32px">@L["Example"]</h2>
    <pre class="card mono small" style="overflow-x:auto">curl @host/api/v1/online</pre>
    <p class="muted small">@L["All times are UTC in ISO 8601. The raw FSD server feed is available directly too:"] <span class="mono">/data.json</span> @L["on the server's HTTP port."]</p>
  </div>
</div>
