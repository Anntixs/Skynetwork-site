@page "/developers"
@{ ViewData["Title"] = "API"; var host = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}"; }
<div class="wrap page with-side">
  <partial name="_DocsNav" />
  <div>
    <h1 style="font-size:34px">@L["Developer API"]</h1>
    <p class="muted" style="max-width:640px">@L["An open read-only API: JSON, no keys, CORS allowed. Online data refreshes every 5 seconds — do not request it more often."]</p>
    <div class="table-wrap" style="margin-top:20px">
      <table>
        <thead><tr><th>@L["Request"]</th><th>@L["Returns"]</th></tr></thead>
        <tbody>
          <tr><td class="mono">GET /api/v1/status</td><td>@L["Network name, FSD server address, data status"]</td></tr>
          <tr><td class="mono">GET /api/v1/online</td><td>@L["Pilots (position, altitude, speed, heading, flight plan) and controllers (frequency, rating, position)"]</td></tr>
          <tr><td class="mono">GET /api/v1/stats</td><td>@L["Members, online, number of connections"]</td></tr>
          <tr><td class="mono">GET /api/v1/members/{cid}</td><td>@L["Member profile: name, controller, pilot and military ratings, pilot and controller hours"]</td></tr>
          <tr><td class="mono">GET /api/v1/members/{cid}/sessions</td><td>@L["Last 50 connections"]</td></tr>
          <tr><td class="mono">GET /api/v1/events</td><td>@L["Upcoming events"]</td></tr>
          <tr><td class="mono">GET /api/v1/events/{id}</td><td>@L["An event"]</td></tr>
          <tr><td class="mono">GET /api/v1/bookings</td><td>@L["Position bookings"]</td></tr>
          <tr><td class="mono">GET /api/v1/news</td><td>@L["News"]</td></tr>
          <tr><td class="mono">GET /api/v1/pilots/{callsign}/route</td><td>@L["An online pilot's route as points (from SimBrief or worked out from the flight plan), the flown track and, for SimBrief plans, registration and step climbs"]</td></tr>
          <tr><td class="mono">GET /api/v1/routes/decode?departure=UUEE&amp;destination=EDDF&amp;route=…</td><td>@L["A route text as points: waypoints, airways expanded, coordinates; the tokens not found"]</td></tr>
          <tr><td class="mono">GET /api/v1/airports/{icao}/layout</td><td>@L["Airport diagram: runways, taxiways, aprons, stands (OpenStreetMap)"]</td></tr>
          <tr><td class="mono">GET /api/v1/metar/{icao}</td><td>@L["Current METAR"]</td></tr>
          <tr><td class="mono">POST /api/v1/auth/pilot</td><td>@L["Checks a member's CID and password for SkyPilot and returns the name and rating; 401 if wrong, 403 if suspended"]</td></tr>
          <tr><td class="mono">GET /api/flightplans/latest?cid={cid}</td><td>@L["The member's latest flight plan (SkyPilot format); 404 if there is none"]</td></tr>
        </tbody>
      </table>
    </div>
    <h2 style="font-size:20px;margin-top:32px">@L["Example"]</h2>
    <pre class="card mono small" style="overflow-x:auto">curl @host/api/v1/online</pre>
    <p class="muted small">@L["All times are UTC in ISO 8601. The raw FSD server feed is available directly too:"] <span class="mono">/data.json</span> @L["on the server's HTTP port."]</p>

    <h2 id="connect" style="font-size:24px;margin-top:40px">SkyNetwork Connect</h2>
    <p class="muted" style="max-width:720px">@L["Sign-in with SkyNetwork for division sites and other sites of the network (OAuth 2.0, authorization code flow, PKCE supported). The member signs in on the network site and agrees once; the site never sees the password. A network administrator registers the site and gives it a client ID and secret."]</p>
    <ol class="muted" style="max-width:720px">
      <li>@L["Send the member to"] <span class="mono">GET @host/oauth/authorize?response_type=code&amp;client_id=…&amp;redirect_uri=…&amp;scope=profile&amp;state=…</span> @L["(optionally code_challenge and code_challenge_method=S256)."]</li>
      <li>@L["The member comes back to redirect_uri with code and state (or error=access_denied)."]</li>
      <li>@L["Exchange the code within 5 minutes:"] <span class="mono">POST @host/oauth/token</span> @L["(form: grant_type=authorization_code, code, redirect_uri, client_id, client_secret, code_verifier) → access_token for 1 hour."]</li>
      <li><span class="mono">GET @host/oauth/userinfo</span> @L["with Authorization: Bearer access_token → cid, name, rating, staffRank, pilotRating, militaryRating, country; email with the email scope."]</li>
    </ol>

    <h2 id="division-api" style="font-size:24px;margin-top:40px">@L["Division API"]</h2>
    <p class="muted" style="max-width:720px">@L["For division websites. Every request carries the division's key, issued by a network administrator: the Authorization: Bearer header (or X-Api-Key). Answers are JSON; errors come as { \"error\": code, \"message\": text }."]</p>
    <div class="table-wrap" style="margin-top:12px">
      <table>
        <thead><tr><th>@L["Request"]</th><th>@L["Returns"]</th></tr></thead>
        <tbody>
          <tr><td class="mono">GET /api/division/v1/members/{cid}</td><td>@L["A member and their ratings: check a CID before the exam"]</td></tr>
          <tr><td class="mono">POST /api/division/v1/rating-requests</td><td>@L["The student passed the exam: ask for the rating. A supervisor approves it"]</td></tr>
          <tr><td class="mono">GET /api/division/v1/rating-requests[?status=&amp;cid=]</td><td>@L["Your rating requests and their status: pending, approved, declined, withdrawn"]</td></tr>
          <tr><td class="mono">GET /api/division/v1/rating-requests/{id}</td><td>@L["A rating request"]</td></tr>
          <tr><td class="mono">DELETE /api/division/v1/rating-requests/{id}</td><td>@L["Withdraw a request that is still pending"]</td></tr>
        </tbody>
      </table>
    </div>
    <h3 style="font-size:17px;margin-top:24px">@L["Rating request"]</h3>
    <pre class="card mono small" style="overflow-x:auto">curl -X POST @host/api/division/v1/rating-requests \
  -H "Authorization: Bearer skd_..." -H "Content-Type: application/json" \
  -d '{
    "cid": 25,
    "track": "atc",
    "rating": "S2",
    "examinerCid": 7,
    "examinerName": "Ivan Petrov",
    "examDate": "2026-09-20",
    "score": "92%",
    "reportUrl": "https://academy.example/exams/1841",
    "comment": "Practical exam at UUEE_TWR",
    "externalId": "exam-1841"
  }'</pre>
    <ul class="muted small" style="max-width:720px">
      <li>@L["track: atc, pilot or military; rating: its short name (S1…I3, PPL…FE, M1…M4)."]</li>
      <li>@L["The member must not hold this rating already. One pending request per member and track."]</li>
      <li>@L["externalId makes retries safe: the same value returns the request already created instead of a new one."]</li>
      <li>@L["Answers: 201 created, 200 already sent, 401 wrong key, 404 no such member, 409 a request is already pending, 422 not allowed, 429 too many requests."]</li>
      <li>@L["Supervisors approve controller ratings up to C3 and all pilot and military ratings; instructor ratings (I1–I3) are approved by administrators."]</li>
    </ul>
  </div>
</div>
