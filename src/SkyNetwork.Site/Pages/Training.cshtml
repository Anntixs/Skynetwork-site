@page "/training"
@model TrainingModel
@{ ViewData["Title"] = L["Training"]; var m = Me.Member!; var d = Model.Division; }
<div class="wrap page with-side">
  <partial name="_AccountNav" />
  <div>
    <h1 style="font-size:30px">@L["Training"]</h1>
    <p class="muted" style="max-width:720px">@L["Training is run by the divisions. Join your division, apply to its academy: its instructors train you and hold the exam. After the exam the division sends a rating request, and a network supervisor approves it."] <a href="/docs/ratings">@L["About ratings"]</a></p>
    @if (Model.Message != null) { <div class="alert ok">@L[Model.Message]</div> }
    @if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }

    <div class="card" style="margin-bottom:24px">
      <div class="section-head" style="margin-bottom:6px">
        <h3 style="margin:0">@L["My division"]</h3>
        @if (d != null) { <span class="badge accent">@d.Code</span> }
      </div>
      @if (d != null)
      {
        <p style="margin:0 0 10px"><a href="/divisions/@d.Code"><b>@d.Name</b></a>@(d.Region.Length > 0 ? " · " + d.Region : "")</p>
        @if (d.Website.Length > 0) { <p style="margin:0 0 10px"><a class="btn btn-small" href="@d.Website" target="_blank" rel="noopener">@L["Open the division's academy"]</a></p> }
      }
      else
      {
        <p class="muted small" style="margin:0 0 10px">@L["You are not in a division yet. Choose one to apply for training."]</p>
      }
      <form method="post" asp-page-handler="Division" class="inline-form">
        <label>@L["Division"]
          <select name="divisionId">
            <option value="0">—</option>
            @foreach (var x in Model.Divisions) { <option value="@x.Id" selected="@(x.Id == d?.Id)">@x.Code — @x.Name</option> }
          </select>
        </label>
        <button class="btn" type="submit">@(d == null ? L["Join"] : L["Change"])</button>
      </form>
    </div>

    <div class="grid" style="gap:16px;margin-bottom:36px">
      @foreach (var (track, title) in TrainingTracks.All)
      {
        int current = TrainingTracks.Current(track, m);
        var next = TrainingTracks.Next(track, current);
        bool pending = Model.Requests.Any(r => r.Track == track && r.Status is "open" or "accepted")
                       || Model.RatingRequests.Any(r => r.Track == track && r.Status == "pending");
        <div class="card">
          <div class="section-head" style="margin-bottom:6px">
            <h3 style="margin:0">@L[title]</h3>
            <span><span class="badge accent">@TrainingTracks.Short(track, current)</span> @L[TrainingTracks.Long(track, current)]</span>
          </div>
          @if (pending)
          {
            <p class="muted small" style="margin:0">@L["Your request is being handled — the status is below."]</p>
          }
          else if (next is { } n && d != null)
          {
            <form method="post" asp-page="/Training" class="form" style="max-width:none">
              <input type="hidden" name="Track" value="@track">
              <input type="hidden" name="Target" value="@n">
              <label><span>@L.F("Apply to the {0} academy for", d.Code) <b>@TrainingTracks.Short(track, n)</b> — @L[TrainingTracks.Long(track, n)]</span>
                <textarea name="Text" maxlength="2000" placeholder="@L["When you can train, your experience, questions"]"></textarea>
              </label>
              <div><button class="btn btn-primary" type="submit">@L["Apply"]</button></div>
            </form>
          }
          else if (next != null)
          {
            <p class="muted small" style="margin:0">@L["Join a division to apply."]</p>
          }
          else
          {
            <p class="muted small" style="margin:0">@L["You hold the highest rating you can apply for on this track."]</p>
          }
        </div>
      }
    </div>

    @if (Model.Requests.Count > 0)
    {
      <h2 style="font-size:20px">@L["My academy applications"]</h2>
      <div class="table-wrap" style="margin-bottom:28px">
        <table>
          <thead><tr><th>@L["Division"]</th><th>@L["Rating"]</th><th>@L["Status"]</th><th>@L["Instructor comment"]</th><th>@L["Filed"]</th></tr></thead>
          <tbody>
          @foreach (var r in Model.Requests)
          {
            <tr><td>@(r.DivisionCode.Length > 0 ? r.DivisionCode : "—")</td><td>@r.TargetShort</td>
                <td><span class="badge">@L[SupportService.TrainingStatuses[r.Status]]</span></td>
                <td>@r.StaffComment</td><td>@Format.Utc(r.Created)</td></tr>
          }
          </tbody>
        </table>
      </div>
    }

    @if (Model.RatingRequests.Count > 0)
    {
      <h2 style="font-size:20px">@L["Rating requests after exams"]</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>@L["Division"]</th><th>@L["Rating"]</th><th>@L["Exam"]</th><th>@L["Status"]</th><th>@L["Supervisor comment"]</th><th>@L["Updated"]</th></tr></thead>
          <tbody>
          @foreach (var r in Model.RatingRequests)
          {
            <tr><td>@r.DivisionCode</td><td>@r.CurrentShort → <b>@r.TargetShort</b></td><td>@r.ExamDate @(r.Score.Length > 0 ? "· " + r.Score : "")</td>
                <td><span class="badge @(r.Status == "approved" ? "accent" : "")">@L[DivisionService.RequestStatuses[r.Status]]</span></td>
                <td>@r.ReviewComment</td><td>@Format.Utc(r.Updated)</td></tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
