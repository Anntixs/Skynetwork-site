@page "/reset-password"
@model ResetPasswordModel
@{ ViewData["Title"] = L["New password"]; }
<div class="wrap page">
  <div class="auth-box">
    <h1 style="font-size:34px">@L["New password"]</h1>
    @if (Model.Done)
    {
      <div class="alert ok">@L["The password is changed. Use it to sign in and to connect to the network."]</div>
      <p><a class="btn btn-primary" href="/login">@L["Sign in"]</a></p>
    }
    else if (!Model.Valid)
    {
      <div class="alert error">@L["The link is invalid or has expired. Ask for a new one."]</div>
      <p><a class="btn" href="/forgot-password">@L["Forgot your password?"]</a></p>
    }
    else
    {
      @if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }
      <p class="muted">@L.F("Account CID {0}. One password for the website and for connecting to the network.", Model.Cid)</p>
      <form method="post" class="form">
        <input type="hidden" name="Token" value="@Model.Token">
        <label>@L["New password"]<input name="NewPassword" type="password" required minlength="8" autocomplete="new-password"></label>
        <label>@L["Repeat new password"]<input name="Confirm" type="password" required minlength="8" autocomplete="new-password"></label>
        <button class="btn btn-primary" type="submit">@L["Change password"]</button>
      </form>
    }
  </div>
</div>
