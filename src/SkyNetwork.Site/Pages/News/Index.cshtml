@page "/news"
@inject ContentService Site
@{
    ViewData["Title"] = L["News"];
    var posts = Site.News(50);
}
<div class="wrap page">
  <div class="page-head"><h1>@L["News"]</h1><p>@L["Changes to the network and software."]</p></div>
  @if (posts.Count == 0) { <div class="empty">@L["No news yet."]</div> }
  <div class="news-list prose">
    @foreach (var n in posts)
    {
      <div class="news-item @(n.BannerUrl != null ? "with-thumb" : "")">
        @if (n.BannerUrl is { } thumb) { <a href="/news/@n.Id" class="news-thumb"><img src="@thumb" alt="" loading="lazy"></a> }
        <div class="muted small">@Format.Date(n.Created) · @n.AuthorName</div>
        <h3><a href="/news/@n.Id">@n.Title</a></h3>
        <p class="muted">@(n.Body.Length > 280 ? n.Body[..280] + "…" : n.Body)</p>
      </div>
    }
  </div>
</div>
