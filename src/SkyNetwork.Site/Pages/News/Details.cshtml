@page "/news/{id:long}"
@model SkyNetwork.Site.Pages.News.DetailsModel
@{ var p = Model.Post; bool en = !L.IsRu; ViewData["Title"] = p.TitleIn(en); }
<div class="wrap page">
  @if (p.BannerUrlIn(en) is { } banner) { <img class="page-banner @p.BannerClasses" src="@banner" alt=""> }
  <div class="eyebrow"><a href="/news">@L["News"]</a></div>
  <h1>@p.TitleIn(en)</h1>
  <p class="muted">@Format.Date(p.Created) · @p.AuthorName</p>
  @if (!p.Published) { <div class="alert">@L["Draft — visible to the team only."]</div> }
  <div class="prose"><p>@p.BodyIn(en)</p></div>
</div>
