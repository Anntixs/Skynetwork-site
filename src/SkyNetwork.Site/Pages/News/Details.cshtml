@page "/news/{id:long}"
@model SkyNetwork.Site.Pages.News.DetailsModel
@{ ViewData["Title"] = Model.Post.Title; }
<div class="wrap page">
  <div class="eyebrow"><a href="/news">Новости</a></div>
  <h1>@Model.Post.Title</h1>
  <p class="muted">@Format.Date(Model.Post.Created) · @Model.Post.AuthorName</p>
  @if (!Model.Post.Published) { <div class="alert">Черновик — видно только команде.</div> }
  <div class="prose"><p>@Model.Post.Body</p></div>
</div>
