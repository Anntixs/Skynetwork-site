@model Member
@* The member's ratings, shown on profiles and in the account. A staff rank (SUP, ADM) and the
   controller rating are stored apart but shown together, as one rating. *@
<div class="rating-cards">
  <div class="rating-card">
    <span class="label">@L["Rating"]</span>
    <b>
      @if (Model.IsStaff)
      {
        <span class="badge accent">@Ratings.Short(Model.StaffRank)</span> @L[Ratings.Long(Model.StaffRank)]
        <span class="muted"> · </span>
        <span class="badge">@Model.RatingShort</span> @L[Model.RatingLong]
      }
      else
      {
        <span class="badge accent">@Model.RatingShort</span> @L[Model.RatingLong]
      }
    </b>
  </div>
  <div class="rating-card">
    <span class="label">@L["Pilot rating"]</span>
    <b><span class="badge">@PilotRatings.Pilot.Short(Model.PilotRating)</span> @L[PilotRatings.Pilot.Long(Model.PilotRating)]</b>
  </div>
  <div class="rating-card">
    <span class="label">@L["Military rating"]</span>
    <b><span class="badge">@PilotRatings.Military.Short(Model.MilitaryRating)</span> @L[PilotRatings.Military.Long(Model.MilitaryRating)]</b>
  </div>
</div>
