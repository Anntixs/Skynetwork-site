@model string
@* Language and theme switches, shown in the header of both layouts. *@
<div class="prefs">
  <details class="lang-menu">
    <summary title="@L["Language"]" aria-label="@L["Language"]"><span class="mono">@L.Code.ToUpperInvariant()</span></summary>
    <div class="menu">
      @foreach (var (code, name) in Lang.Supported)
      {
        <a href="/lang/@code?r=@Uri.EscapeDataString(Model)" class="@(code == L.Code ? "active" : "")" lang="@code">@name</a>
      }
    </div>
  </details>
  <button type="button" class="theme-toggle" data-theme-toggle title="@L["Light or dark theme"]" aria-label="@L["Light or dark theme"]">
    <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
    <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
  </button>
</div>
