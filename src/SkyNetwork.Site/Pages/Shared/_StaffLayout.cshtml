@inject SupportService Support
@{
    Layout = "_Layout";
    string path = Context.Request.Path.Value ?? "";
    string A(string p) => (p == "/staff" ? path.Equals(p, StringComparison.OrdinalIgnoreCase) : path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var (openTickets, openTraining) = Support.Counts();
}
<div class="staff-bar">
  <div class="wrap">
    <b>Управление сетью</b>
    <span>· @Me.Member!.Name, @Me.Member.RatingShort@(Me.Roles.Count > 0 ? " · " + string.Join(", ", Me.Roles.Select(r => Permissions.Roles[r])) : "")</span>
  </div>
</div>
<div class="wrap page with-side">
  <nav class="side" aria-label="Управление">
    <div class="side-title">Сеть</div>
    <a href="/staff" class="@A("/staff")">Обзор</a>
    @if (Me.Has(Perm.ViewMembers)) { <a href="/staff/members" class="@A("/staff/members")">Участники</a> }
    <a href="/staff/team" class="@A("/staff/team")">Команда</a>
    @if (Me.Has(Perm.Online)) { <a href="/staff/online" class="@A("/staff/online")">В эфире</a> }
    @if (Me.Has(Perm.Tickets) || Me.Has(Perm.Training)) { <div class="side-title">Работа</div> }
    @if (Me.Has(Perm.Tickets)) { <a href="/staff/tickets" class="@A("/staff/tickets")">Обращения @if (openTickets > 0) { <span class="count">@openTickets</span> }</a> }
    @if (Me.Has(Perm.Training)) { <a href="/staff/training" class="@A("/staff/training")">Обучение @if (openTraining > 0) { <span class="count">@openTraining</span> }</a> }
    @if (Me.Has(Perm.Events) || Me.Has(Perm.News) || Me.Has(Perm.Bookings)) { <div class="side-title">Сайт</div> }
    @if (Me.Has(Perm.Events)) { <a href="/staff/events" class="@A("/staff/events")">Мероприятия</a> }
    @if (Me.Has(Perm.News)) { <a href="/staff/news" class="@A("/staff/news")">Новости</a> }
    @if (Me.Has(Perm.Bookings)) { <a href="/staff/bookings" class="@A("/staff/bookings")">Бронирования</a> }
    @if (Me.Has(Perm.Audit)) { <div class="side-title">Контроль</div><a href="/staff/audit" class="@A("/staff/audit")">Журнал действий</a> }
  </nav>
  <div>
    @RenderBody()
  </div>
</div>
@section Head { @await RenderSectionAsync("Head", required: false) }
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
